<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aussie Lunchbox 주간 가격 수집 (launchd LaunchAgent) — Kiwi `nz.kiwilunchbox.prices`와 같은 구조.

  🔴 왜 로컬인가: Woolworths AU가 GitHub 러너에서 막힌다(08-16부터 캐시 146개 전부 추정가). 이 Mac에선 200이다.
  ⚠️ cron이 아니라 launchd: 노트북이 자고 있으면 깨어날 때 한 번 따라잡는다.
  ⚠️ 일 19:00 NZ — Kiwi(18:00)와 한 시간 띄운다. 둘 다 vitest 전체를 돈다.
  ★ 안 돌면 Actions 「Weekly Price Check」(목)의 10일 신선도 가드가 빨개진다.
  🔴 스크립트는 **main 체크아웃**(`aussie-lunchbox`)을 쓴다 — main이 아니면 그 주는 건너뛴다.

  설치:
    cp ops/aussie-prices.plist ~/Library/LaunchAgents/com.aussielunchbox.prices.plist
    launchctl load ~/Library/LaunchAgents/com.aussielunchbox.prices.plist
  즉시 한 번:   launchctl start com.aussielunchbox.prices
  상태·로그:   launchctl list | grep aussielunchbox · tail -60 ~/Library/Logs/aussielunchbox-prices.log
  해제:        launchctl unload ~/Library/LaunchAgents/com.aussielunchbox.prices.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aussielunchbox.prices</string>

  <!-- 로그인 셸로 부른다 — launchd의 PATH는 최소라서 node·npm을 못 찾는다. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>"/Volumes/For MAC APP/Dev Projects/aussie-lunchbox/scripts/collect_prices_local.sh"</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>19</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/yongjaelee/Library/Logs/aussielunchbox-prices.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yongjaelee/Library/Logs/aussielunchbox-prices.log</string>
</dict>
</plist>
